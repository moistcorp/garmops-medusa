# Local development defaults. Copy this file to .env before starting Compose.
# Set DATABASE_URL to the database used by this environment. Never commit credentials.
NODE_ENV=development
PORT=9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000

DATABASE_URL=postgresql://user:password@localhost:5432/garmops

REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
LOCKING_REDIS_URL=redis://redis:6379/2

# Local browser origins. Production domains belong in deployment secrets/config.
STORE_CORS=http://localhost:3000,http://localhost:9000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Secrets for signing JWTs and cookies. Replace with your own.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Third-party service credentials. Replace with your own.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/customer/google/callback

#Resend credentials for sending emails. Replace with your own.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=orders@garmops.com

#PAYU credentials for testing. Replace with your own for production.
PAYU_ENV=test
PAYU_KEY=replace-with-payu-key
PAYU_SALT=replace-with-payu-salt
PAYU_CALLBACK_URL=http://localhost:9000/garmops/payments/payu/callback


R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=replace-with-public-bucket
R2_PRIVATE_BUCKET=replace-with-private-bucket
R2_PUBLIC_URL=https://replace-with-public-media-host


MALWARE_SCANNER_URL=http://malware-scanner:8080
MALWARE_SCANNER_TOKEN=replace-with-scanner-token
MALWARE_SCANNER_HOST=malware-scanner
MALWARE_SCANNER_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=15000


INVOICE_SELLER_NAME=M/s Moist Corp
INVOICE_SELLER_GSTIN=09HPFPS8162L1ZY
INVOICE_SELLER_ADDRESS=2nd Floor, Q-5, Surajpur Industria Area, Site-5,Kasna, Greater Noida, Uttar Pradesh, India
INVOICE_SELLER_STATE=UTTAR PRADESH
INVOICE_SELLER_PIN=201312


FRONTEND_URL=http://localhost:3000
FOUNDRY_URL=http://localhost:3000/foundry

# Redis is local infrastructure; it is bound to localhost only.
REDIS_PORT=6379
