# Local development defaults. Copy this file to .env before starting Compose.
# The actual DATABASE_URL must be the Neon pooled PostgreSQL connection string.
NODE_ENV=development
PORT=9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
LOCKING_REDIS_URL=redis://redis:6379/2

# Local browser origins. Production domains belong in deployment secrets/config.
STORE_CORS=http://localhost:3000,http://localhost:9000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

JWT_SECRET=replace-with-a-random-jwt-secret
COOKIE_SECRET=replace-with-a-random-cookie-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-random-64-character-key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/customer/google/callback
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=Garmops <noreply@example.com>
PAYU_ENV=test
PAYU_KEY=replace-with-payu-merchant-key
PAYU_SALT=replace-with-payu-salt
PAYU_CALLBACK_URL=http://localhost:9000/store/garmops/payments/payu/callback
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PUBLIC_BUCKET=replace-with-public-bucket
R2_PRIVATE_BUCKET=replace-with-private-bucket
R2_PUBLIC_URL=https://media.example.com
MALWARE_SCANNER_URL=http://malware-scanner:8080
MALWARE_SCANNER_TOKEN=replace-with-scanner-token
MALWARE_SCAN_TIMEOUT_MS=15000
INVOICE_SELLER_NAME=Garmops
INVOICE_SELLER_GSTIN=replace-with-seller-gstin
INVOICE_SELLER_ADDRESS=replace-with-seller-address
INVOICE_SELLER_STATE=replace-with-seller-state
INVOICE_SELLER_PIN=replace-with-seller-pin
FRONTEND_URL=http://localhost:3000
FOUNDRY_URL=http://localhost:3000/foundry

# Redis is local infrastructure; it is bound to localhost only.
REDIS_PORT=6379
