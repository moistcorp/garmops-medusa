# Optional overrides for docker-compose.portable.yml.
# The defaults are suitable only for localhost testing. Use strong random values
# and HTTPS origins before routing traffic through Cloudflare Tunnel.
POSTGRES_DB=garmops
POSTGRES_USER=garmops
POSTGRES_PASSWORD=replace-with-a-long-random-password
# The bundled PostgreSQL service is private to Docker and does not use TLS.
DATABASE_SSL_MODE=disable
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
BIND_ADDRESS=127.0.0.1

CUSTOMER_APP_URL=http://localhost:3000
STAFF_APP_URL=http://localhost:3001
MEDUSA_PUBLIC_URL=http://localhost:9000
STORE_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000

# Add external integration credentials only when testing those integrations.
PAYU_ENV=test
PAYU_KEY=
PAYU_SALT=
PAYU_CALLBACK_URL=http://localhost:9000/garmops/payments/payu/callback
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
RESEND_API_KEY=
RESEND_FROM=Garmops <noreply@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/customer/google/callback
